<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="repository.cybergrimes.embuary" name="Embuary Repository (Cybergrimes fork)" version="1.0.0" provider-name="Cybergrimes">
	<extension point="xbmc.addon.repository" name="Embuary Repository (Cybergrimes fork)">
		<dir>
			<info compressed="false">https://cybergrimes.github.io/skin.embuary/repo/addons.xml</info>
			<checksum>https://cybergrimes.github.io/skin.embuary/repo/addons.xml.md5</checksum>
			<datadir zip="true">https://cybergrimes.github.io/skin.embuary/repo/</datadir>
		</dir>
	</extension>
	<extension point="xbmc.addon.metadata">
		<summary lang="en_GB">Feed for the Embuary Omega fork add-ons</summary>
		<description lang="en_GB">Provides script.embuary.helper and script.embuary.info for the Embuary (Omega) skin fork by Cybergrimes, based on the work of Sualfred.</description>
		<platform>all</platform>
		<license>CC-BY-NC-ND-4.0</license>
		<source>https://github.com/cybergrimes/skin.embuary</source>
	</extension>
</addon>
<addon id="script.embuary.helper" name="Embuary Helper" version="2.0.9" provider-name="sualfred, cybergrimes (fork)">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.pil" version="1.1.7"/>
    </requires>
    <extension point="xbmc.python.script" library="default.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.python.pluginsource" library="plugin.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="service.py" />
    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <license>GPL-2.0-only</license>
        <forum>https://forum.kodi.tv/showthread.php?tid=345318</forum>
        <source>https://github.com/cybergrimes/script.embuary.helper</source>
        <news>2.0.9 (Cybergrimes fork build based on upstream 2.0.9): Kodi 21 / Python 3 and Pillow 10+ compatibility fixes, small optimizations. See CHANGELOG.md.</news>
        <assets>
            <icon>resources/icon.png</icon>
            <fanart>resources/fanart.jpg</fanart>
        </assets>
        <summary lang="en_GB">Embuary Helper Script</summary>
        <description lang="en_GB">Helper script to provide features and functions to the Embuary skin. A full documentation can be found on GitHub: https://github.com/sualfred/script.embuary.helper/wiki. Original author: Sualfred (https://github.com/sualfred/script.embuary.helper). This is a fork maintained by Cybergrimes (https://github.com/cybergrimes/script.embuary.helper), licensed under GPL-2.0-only like the original.</description>
    </extension>
</addon>
<addon id="script.embuary.info" name="Embuary Info" version="2.0.9" provider-name="sualfred, Cybergrimes (fork)">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.requests" version="2.9.1"/>
        <import addon="script.module.arrow" version="0.10.0"/>
        <import addon="script.module.simplecache" version="2.0.2" />
        <import addon="script.module.routing" version="0.2.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="plugin.py">
      <provides>video</provides>
    </extension>
    <extension point="xbmc.python.script" library="default.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.service" library="service.py" />
    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <license>Apache-2.0</license>
        <forum>https://forum.kodi.tv/showthread.php?tid=346034</forum>
        <source>https://github.com/cybergrimes/script.embuary.info</source>
        <news>2.0.9 (Cybergrimes fork of sualfred/script.embuary.info 2.0.10): Kodi 21 / Python 3 fixes, shared HTTP session, safer YouTube trailer checks. See CHANGELOG.md.</news>
        <assets>
            <icon>resources/icon.png</icon>
            <fanart>resources/fanart.jpg</fanart>
        </assets>
        <summary lang="de_DE">Embuary Info Script</summary>
        <summary lang="de_DE">Embuary Info Script</summary>
        <summary lang="en_GB">Embuary Info Script</summary>
        <description lang="de_DE">Helfer Script das Abfragen von The Movie DB informationen für Personen, Serien und Filme zu ermöglichen. Funktioniert am besten mit einer Skin Integration.</description>
        <description lang="de_DE">Helfer Script das Abfragen von The Movie DB informationen für Personen, Serien und Filme zu ermöglichen. Funktioniert am besten mit einer Skin Integration.</description>
        <description lang="en_GB">Helper script to provide The Movie DB informations for persons, shows and movies. Works best with a skin integration.</description>
    </extension>
</addon>
</addons>
